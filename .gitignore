node_modules/
dist/
.vitest/
*.log
.DS_Store
.sp1-cache/
__pycache__/

# Generated by scripts/copy-static-assets.mjs before dev/build; not source.
public/coi-serviceworker.min.js

# Real models are fetched at runtime from Hugging Face (D-04), never
# committed. The tiny synthetic fixtures under tests/fixtures/ are the
# exception — they're a few hundred bytes with no learned weights, needed
# for tests/browser/*.
*.onnx
!tests/fixtures/*.onnx

# Synthetic perf inputs generated by scripts/perf/make-input.py — large,
# reproducible from the seeded recipe, not source (plans/perf-divergence S-103).
perf/input/

# CPU-frequency sampling scratch files from scripts/perf/run-matrix.mjs
# (D-110 drift check); their summary stats are merged into the run's JSON.
perf/results/*.cpufreq.csv

# Raw float32 dumps from the divergence harness (plans/perf-divergence
# S-108) -- large, regenerable from the harness commands logged in
# research/divergence/BUDGET.md. Only result.json files and small
# markdown/JSON summary tables are committed.
research/divergence/raw/

